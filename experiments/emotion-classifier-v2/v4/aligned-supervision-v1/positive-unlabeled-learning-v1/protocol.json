    "trainableParameters": "classifier and encoder layers 10-11 only",
    "optimizer": "AdamW",
    "learningRate": 0.000001,
    "weightDecay": 0.01,
    "epochs": 1,
    "epochDefinition": "one shuffled pass through every unlabeled cell for every label",
    "batchSizeCells": 32,
    "positiveCellsPerBatch": 8,
    "unlabeledCellsPerBatch": 24,
    "positiveSampling": "seeded with-replacement sampling from the target label's confirmed positives",
    "seed": 54,
    "maxLength": 512,
    "gradientClipNorm": 1.0,
    "scheduler": "linear with 10% warmup",
    "runs": 1,
    "hyperparameterSweep": false
  },
