  "objective": {
    "name": "per-label non-negative positive-unlabeled logistic risk (nnPU)",
    "formula": "pi * mean_P(softplus(-z)) + max(0, mean_U(softplus(z)) - pi * mean_P(softplus(z)))",
    "scope": "one target Product-18 label per stratified batch; no loss on other logits",
    "classPrior": {
      "valuePerLabel": 0.05555555555555555,
      "method": "uniform 1/18 from the frozen training-side generator design: each source cohort has exactly one intended positive assignment per Event on average and balanced intended assignments across 18 labels",
