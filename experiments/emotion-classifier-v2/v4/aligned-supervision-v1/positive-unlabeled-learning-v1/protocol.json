  "hypothesis": "Confirmed positives plus non-negative PU risk can learn Product-18 without treating any unconfirmed cell as a hard negative.",
  "labels": [
    "admiration", "amusement", "anger", "annoyance", "caring", "confusion",
    "curiosity", "disappointment", "disgust", "excitement", "fear", "gratitude",
