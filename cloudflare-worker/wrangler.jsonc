{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petalpal-emotion-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "REPORT_NARRATIVE_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "env": {
    "staging": {
      "name": "petalpal-ai-dispatch-staging",
      "vars": {
        "AI_JOB_EXECUTOR_URL": "https://petalpal-v2.onrender.com"
      },
      "queues": {
        "producers": [{ "binding": "AI_JOB_QUEUE", "queue": "petalpal-ai-jobs-staging" }],
        "consumers": [{
          "queue": "petalpal-ai-jobs-staging",
          "max_batch_size": 1,
          "max_batch_timeout": 1,
          "max_retries": 3,
          "max_concurrency": 1
        }]
      },
      "triggers": { "crons": ["*/20 * * * *"] }
    },
    "production": {
      "name": "petalpal-ai-dispatch-production",
      "vars": {
        "AI_JOB_EXECUTOR_URL": "https://petalpal-v2.onrender.com"
      },
      "queues": {
        "producers": [{ "binding": "AI_JOB_QUEUE", "queue": "petalpal-ai-jobs-production" }],
        "consumers": [{
          "queue": "petalpal-ai-jobs-production",
          "max_batch_size": 1,
          "max_batch_timeout": 1,
          "max_retries": 3,
          "max_concurrency": 1
        }]
      },
      "triggers": { "crons": ["*/20 * * * *"] }
    }
  }
}
