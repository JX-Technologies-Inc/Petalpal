{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petalpal-expo-synthetic-9a9d57d",
  "main": "preview-worker.js",
  "compatibility_date": "2026-10-09",
  "keep_names": false,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": { "STATIC_PREVIEW_ONLY": "1" },
  "assets": {
    "directory": "../../mobile/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": { "enabled": false }
}
