{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petalpal-web-preview",
  "main": "worker.js",
  "compatibility_date": "2026-10-09",
  // No public hostname, version URL or custom route is activated by this file.
  // Preview exposure and app.jastrevia.com require separate approval.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "../../mobile/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": { "enabled": false }
}
