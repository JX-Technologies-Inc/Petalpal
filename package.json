{
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "build": "npm install --prefix client && npm run build --prefix client",
        "build:client": "npm run build --prefix client -- --configLoader runner",
        "lint": "npm run lint --prefix client",
        "test": "npm run test:backend && npm run test:client",
        "test:backend": "node --test test/back/*.test.js",
        "test:client": "npm test --prefix client",
        "test:data-models": "node --test test/back/productModels.integration.test.js",
        "check": "npm test && npm run lint && npm run build:client && npx prisma validate && node --check server.js && node --check lib/auth.js",
        "postinstall": "npx prisma generate"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.3.16"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "natural": "^8.1.1",
        "pg": "^8.22.0",
        "prisma": "^7.8.0",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3"
    }
}
