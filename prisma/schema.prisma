// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id
  accountId       String?   @unique
  name            String
  email           String?   @unique
  firebaseUid     String?   @unique
  emailVerifiedAt DateTime?
  avatar          String    @default("🦋")
  timezone        String    @default("UTC") @db.VarChar(64)
  createdAt       DateTime  @default(now())

  garden       Garden?
  flowers      Flower[]
  messages     Message[]
  visitRecords VisitRecord[]

  friends  Friendship[] @relation("UserFriends")
  friendOf Friendship[] @relation("FriendOf")

  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")

  dailyCheckIns           DailyCheckIn[]
  journals                Journal[]
  emotionResults          EmotionResult[]
  fairyState              FairyState?
  reportsCreated          Report[]                 @relation("ReportReporter")
  reportsReceived         Report[]                 @relation("ReportTargetUser")
  aiConsent               AiConsent?
  aiInteractions          AiInteractionMetadata[]
  subscriptionEntitlement SubscriptionEntitlement?
}

model Garden {
  id        String   @id @default(cuid())
  ownerId   String   @unique
  year      Int      @default(2026)
  createdAt DateTime @default(now())

  owner        User          @relation(fields: [ownerId], references: [id])
  flowers      Flower[]
  visitRecords VisitRecord[]
}

model Flower {
  id             String   @id @default(cuid())
  mood           String
  event          String   @default("")
  name           String
  meaning        String
  img            String
  left           Float
  top            Float
  supportCount   Int      @default(0)
  variant        String   @default("standard") @db.VarChar(32)
  rarity         String   @default("COMMON") @db.VarChar(16)
  growthState    String   @default("BLOOMED") @db.VarChar(32)
  visualEffect   String?  @db.VarChar(32)
  season         String?  @db.VarChar(16)
  generationSeed String?  @db.VarChar(64)
  createdAt      DateTime @default(now())

  userId         String
  gardenId       String
  dailyCheckInId String? @unique

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  garden       Garden        @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  dailyCheckIn DailyCheckIn? @relation(fields: [dailyCheckInId], references: [id], onDelete: Cascade)
  messages     Message[]
}

model Message {
  id        String   @id @default(cuid())
  author    String   @default("Friend")
  text      String   @default("")
  createdAt DateTime @default(now())

  flowerId String
  userId   String?

  flower  Flower   @relation(fields: [flowerId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
  reports Report[]
}

model VisitRecord {
  id            String   @id @default(cuid())
  visitorId     String
  visitorName   String
  visitorAvatar String
  action        String
  createdAt     DateTime @default(now())

  gardenId String
  userId   String?

  garden Garden @relation(fields: [gardenId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model FriendRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model DailyCheckIn {
  id        String   @id @default(cuid())
  userId    String
  localDate String   @db.VarChar(10)
  timezone  String   @default("UTC") @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  journal        Journal?
  emotionResult  EmotionResult?
  flower         Flower?
  aiInteractions AiInteractionMetadata[]

  @@unique([userId, localDate])
  @@index([userId, createdAt])
}

model Journal {
  id             String   @id @default(cuid())
  userId         String
  dailyCheckInId String   @unique
  content        String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCheckIn DailyCheckIn @relation(fields: [dailyCheckInId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model EmotionResult {
  id               String        @id @default(cuid())
  userId           String
  dailyCheckInId   String        @unique
  label            String        @db.VarChar(32)
  source           EmotionSource
  confidence       Float?
  secondaryEmotion String?       @db.VarChar(32)
  intensity        Float?
  modelVersion     String?       @db.VarChar(128)
  createdAt        DateTime      @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCheckIn DailyCheckIn @relation(fields: [dailyCheckInId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model FairyState {
  id                  String   @id @default(cuid())
  userId              String   @unique
  onboardingStep      String   @default("EMPTY_GARDEN") @db.VarChar(64)
  onboardingCompleted Boolean  @default(false)
  lastEvent           String?  @db.VarChar(64)
  unlockedFeatures    Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id             String         @id @default(cuid())
  reporterId     String
  reportedUserId String?
  messageId      String?
  category       ReportCategory
  details        String?        @db.Text
  status         ReportStatus   @default(PENDING)
  resolutionNote String?        @db.Text
  createdAt      DateTime       @default(now())
  reviewedAt     DateTime?

  reporter     User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?    @relation("ReportTargetUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  message      Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([reporterId, createdAt])
  @@index([status, createdAt])
}

model AiConsent {
  id              String    @id @default(cuid())
  userId          String    @unique
  termsVersion    String    @db.VarChar(32)
  aiProcessing    Boolean   @default(false)
  personalization Boolean   @default(false)
  memoryEnabled   Boolean   @default(false)
  grantedAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiInteractionMetadata {
  id             String   @id @default(cuid())
  userId         String
  dailyCheckInId String?
  task           String   @db.VarChar(64)
  provider       String   @db.VarChar(64)
  model          String   @db.VarChar(128)
  inputHash      String?  @db.VarChar(64)
  outputLabel    String?  @db.VarChar(64)
  confidence     Float?
  latencyMs      Int?
  inputTokens    Int?
  outputTokens   Int?
  success        Boolean  @default(true)
  errorCode      String?  @db.VarChar(64)
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCheckIn DailyCheckIn? @relation(fields: [dailyCheckInId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([task, createdAt])
}

model SubscriptionEntitlement {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  tier                   SubscriptionTier   @default(FREE)
  status                 SubscriptionStatus @default(INACTIVE)
  source                 String?            @db.VarChar(32)
  externalCustomerId     String?            @unique @db.VarChar(191)
  externalSubscriptionId String?            @unique @db.VarChar(191)
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum EmotionSource {
  USER
  MODEL
}

enum ReportCategory {
  HARASSMENT
  HATE_SPEECH
  SELF_HARM
  SPAM
  PRIVACY
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  CANCELED
}
